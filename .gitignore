# Build output
bin/
obj/
.artifacts/
*.user
*.suo

# Generated by the FlowX compiler — readable on disk for debugging (ADR-0002),
# but a build output, not source.
**/obj/generated/
flowx.manifest.json

# Test and coverage
TestResults/
coverage*.xml
*.coverage
BenchmarkDotNet.Artifacts/

# Local tooling state. Never committed: a .claude/ or CLAUDE.md in the repository
# is a tool artefact, not part of the product.
.claude/
CLAUDE.md
.vs/
.idea/
.vscode/
*.swp
.DS_Store

# Local infrastructure from `flowx dev up`
docker-compose.override.yml
compose.override.yaml
.env.local

# The compose stack's secrets. `.env.example` is tracked and holds no values; `.env` holds the
# password somebody generated and must never be one `git add -A` away from a branch.
.env

# Redis snapshots written by a locally started redis-server during testing.
# The lease-store suite needs a live Redis; its default save behaviour drops a
# dump.rdb in whatever directory the server was started from.
dump.rdb
*.rdb

# reportgenerator writes its report here; a 53k-line Cobertura.xml reached a
# branch through `git add -A` before this line existed.
coverage/
