{
  "$schema": "http://json.schemastore.org/template",
  "author": "FlowX Contributors",
  "classifications": [ "Web", "WebAPI", "FlowX" ],
  "identity": "FlowX.Minimal.CSharp",
  "groupIdentity": "FlowX.Minimal",
  "name": "FlowX application (minimal)",
  "shortName": "flowx-min",
  "description": "The smallest FlowX application that runs: one flow, one capability, one route, no infrastructure.",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "FlowXMinimal",
  "defaultName": "FlowXApp",
  "preferNameDirectory": true,
  "sources": [
    {
      "modifiers": [
        {
          "exclude": [
            "**/bin/**",
            "**/obj/**",
            "**/.vs/**",
            "**/*.user"
          ]
        }
      ]
    }
  ],
  "primaryOutputs": [
    { "path": "FlowXMinimal.csproj" }
  ]
}
