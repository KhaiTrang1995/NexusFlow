{
  "$schema": "http://json.schemastore.org/template",
  "author": "FlowX Contributors",
  "classifications": [ "Web", "WebAPI", "FlowX" ],
  "identity": "FlowX.Web.CSharp",
  "groupIdentity": "FlowX.Web",
  "name": "FlowX application",
  "shortName": "flowx",
  "description": "A FlowX application: one flow, two capabilities, their contracts, and the HTTP endpoint that runs them.",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "FlowXStarter",
  "defaultName": "FlowXApp",
  "preferNameDirectory": true,
  "sources": [
    {
      "modifiers": [
        {
          "exclude": [
            "**/bin/**",
            "**/obj/**",
            "**/.vs/**",
            "**/*.user"
          ]
        }
      ]
    }
  ],
  "primaryOutputs": [
    { "path": "FlowXStarter.csproj" }
  ]
}
