# Copy to .env and fill in. `.env` is ignored by git and by the Docker build context.
#
#   cp .env.example .env
#
# There are no defaults on purpose: compose refuses to start rather than falling back to
# `postgres`/`guest`, because a default credential is the one that survives into production.

# The database password. Generate one; do not reuse anything.
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# The broker's, needed only with `docker compose --profile broker up`. Leave the URL commented
# out and the API starts without a broker: the configured process still runs off the change
# feed, and the three lead.created subscriptions stay silent.
RABBITMQ_PASSWORD=
# FLOWX_RABBITMQ_CONNECTION=amqp://crm:the-same-password@broker:5672/
