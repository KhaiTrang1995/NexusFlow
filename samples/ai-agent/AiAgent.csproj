<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>AiAgent</RootNamespace>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AiAgent.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/FlowX.Abstractions/FlowX.Abstractions.csproj" />
    <ProjectReference Include="../../src/FlowX.Core/FlowX.Core.csproj" />
    <ProjectReference Include="../../src/FlowX.Runtime/FlowX.Runtime.csproj" />
    <ProjectReference Include="../../src/FlowX.Hosting/FlowX.Hosting.csproj" />
    <ProjectReference Include="../../plugins/FlowX.Http/FlowX.Http.csproj" />
    <ProjectReference Include="../../plugins/FlowX.Mcp/FlowX.Mcp.csproj" />

    <!--
      The reviewer this sample publishes as an agent tool. It links no FlowX assembly of its
      own (see its .csproj), so referencing it here adds one assembly and no graph: the
      capability hands it a string and gets findings back.
    -->
    <ProjectReference Include="../../src/FlowX.Ai/FlowX.Ai.csproj" />

    <!--
      The compiler as an ANALYZER, not a library — so the generator runs inside this
      project's build against this project's source, exactly as it would for any consumer.
    -->
    <ProjectReference Include="../../src/FlowX.Compiler/FlowX.Compiler.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      Condition="'$(FlowXGeneratorDisabled)' != 'true'" />

    <ProjectReference Include="../../src/FlowX.Compiler.CodeFixes/FlowX.Compiler.CodeFixes.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      Condition="'$(FlowXGeneratorDisabled)' != 'true'" />
  </ItemGroup>

</Project>
