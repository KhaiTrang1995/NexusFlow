<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Ecommerce</RootNamespace>
    <IsPackable>false</IsPackable>

    <!--
      The sample is the AOT smoke test. If a reference application cannot publish with
      NativeAOT, constraint C2 is a claim rather than a property — so it is enabled here
      rather than only in CI, where nobody would see it until a release.
    -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The in-memory adapters are internal: they are infrastructure, not part of the
      sample's story. Their idempotency behaviour is real logic, though, so the test
      project sees them rather than the sample widening its surface to be testable.
    -->
    <InternalsVisibleTo Include="Ecommerce.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/FlowX.Abstractions/FlowX.Abstractions.csproj" />
    <ProjectReference Include="../../src/FlowX.Core/FlowX.Core.csproj" />
    <ProjectReference Include="../../src/FlowX.Runtime/FlowX.Runtime.csproj" />
    <ProjectReference Include="../../src/FlowX.Hosting/FlowX.Hosting.csproj" />
    <ProjectReference Include="../../plugins/FlowX.Http/FlowX.Http.csproj" />

    <!--
      The compiler is referenced as an ANALYZER, not as a library. That is what makes
      this sample the real test of the generator: it runs inside this project's build,
      against this project's source, exactly as it would for any consumer.
    -->
    <ProjectReference Include="../../src/FlowX.Compiler/FlowX.Compiler.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      Condition="'$(FlowXGeneratorDisabled)' != 'true'" />

    <!--
      The code fixes, referenced the same way for the same reason. They contribute
      nothing to a command-line build — a CodeFixProvider only runs when a host asks it
      for quick actions — so this is not about what the sample compiles to. It is the
      only place in the repository where the fixes are handed to a real csc invocation
      alongside the analyzer, which is what proves the assembly loads in a host that
      does NOT supply Workspaces. That is the failure the split exists to avoid, and it
      is silent when it happens.
    -->
    <ProjectReference Include="../../src/FlowX.Compiler.CodeFixes/FlowX.Compiler.CodeFixes.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      Condition="'$(FlowXGeneratorDisabled)' != 'true'" />
  </ItemGroup>

  <!--
    The control arm for budget B12.

    Setting FlowXGeneratorDisabled=true drops the analyzer and compiles previously
    generated sources as ordinary files instead. Both arms then produce the SAME final
    compilation, and the only difference is whether the generator ran — which is exactly
    the "identical non-FlowX code" the budget names, and what the first attempt at B12
    could not construct.

    Used by scripts/measure-build-overhead.sh. Building this way by hand produces a
    working application too; it is just one nobody would maintain, because the generated
    files would have to be regenerated by hand on every change.
  -->
  <ItemGroup Condition="'$(FlowXGeneratorDisabled)' == 'true'">
    <Compile Include="$(FlowXPreGeneratedDir)/**/*.g.cs" />
  </ItemGroup>

</Project>
