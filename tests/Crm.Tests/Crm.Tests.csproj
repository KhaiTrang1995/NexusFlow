<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="2.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.3" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <!-- A real server, so the sample's wire contract is asserted on the wire. -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The sample project itself, not a copy of it. If the sample stops compiling or its schema
      changes shape, these tests fail — which is the only way a reference application stays a
      reference rather than becoming stale documentation.
    -->
    <ProjectReference Include="../../samples/crm/Crm.csproj" />

    <!--
      The PostgreSQL adapter, for BuildDataSource. Every test here gets its own schema and
      migrates it from nothing, and the search_path that makes a schema selectable is the
      adapter's decision rather than this project's to restate.
    -->
    <ProjectReference Include="../../plugins/FlowX.Postgres/FlowX.Postgres.csproj" />
  </ItemGroup>

</Project>
