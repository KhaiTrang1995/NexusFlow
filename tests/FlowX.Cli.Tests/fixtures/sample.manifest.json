{
  "schemaVersion": "0.1.0",
  "application": { "name": "Sample.App", "version": "1.0.0" },
  "flows": [{
    "id": "order.place", "version": "1.0.0", "profile": "Ephemeral", "deadline": "PT30S",
    "input": { "type": "PlaceOrder" }, "output": { "type": "OrderResult" },
    "steps": [
      { "id": 0, "kind": "Capability", "capability": "order.validate@1.0.0" },
      { "id": 1, "kind": "Capability", "capability": "inventory.reserve@1.0.0", "compensation": "inventory.release@1.0.0" },
      { "id": 2, "kind": "Capability", "capability": "payment.capture@2.1.0" },
      { "id": 3, "kind": "Emit", "event": "order.placed" }
    ],
    "emits": ["order.placed"]
  }],
  "capabilities": [
    { "id": "order.validate", "version": "1.0.0", "input": "A", "output": "B", "authorization": {"mode":"Authenticated"}, "idempotent": true, "sideEffects": [] },
    { "id": "inventory.reserve", "version": "1.0.0", "input": "A", "output": "B", "authorization": {"mode":"Authenticated"}, "idempotent": true, "sideEffects": ["inventory-ledger"] },
    { "id": "payment.capture", "version": "2.1.0", "input": "A", "output": "B", "authorization": {"mode":"Permission","value":"payment.write"}, "idempotent": false, "sideEffects": ["payment-gateway"] }
  ]
}
