<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="2.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.3" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <!-- Compiles the emitted source to prove it is valid C#, not merely plausible text. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      A plain reference, not an analyzer reference: these tests exercise the model and
      emitter as ordinary classes. Testing a generator only through the compiler is how
      generator test suites become slow and untrustworthy — the pure layers are tested
      as pure layers, and only the Roslyn plumbing needs a compilation.
    -->
    <ProjectReference Include="../../src/FlowX.Compiler/FlowX.Compiler.csproj" />
    <ProjectReference Include="../../src/FlowX.Runtime/FlowX.Runtime.csproj" />
  </ItemGroup>

</Project>
